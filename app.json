{
  "expo": {
    "name": "Devrem",
    "slug": "devrem",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "devrem",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devrem.app"
    },
    "android": {
      "package": "com.devrem.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Devrem, profil fotoğrafını seçebilmen için fotoğraflarına erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e91a377-29fd-4160-b86c-ab4ccdd3e4a6"
      }
    },
    "owner": "onurcanozovali"
  }
}
