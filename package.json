{
  "name": "devrem",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "seed:discovery": "pnpm --dir functions run seed:discovery",
    "seed:discovery:clear": "pnpm --dir functions run seed:discovery:clear",
    "seed:discovery:verify": "pnpm --dir functions run seed:discovery:verify",
    "test:theme": "tsx --test src/theme/colors.test.ts src/theme/themeMode.test.ts",
    "test:home": "tsx --test src/features/home/services/homeDomain.test.ts",
    "test:matching": "tsx --test src/features/matching/services/discoveryDomain.test.ts",
    "test:functions": "tsx --test functions/test/accountDeletion.test.ts functions/test/discoverySeed.test.ts functions/test/publicProfile.test.ts",
    "test:preparation": "tsx --test src/features/preparation/services/preparationDomain.test.ts",
    "test:profile": "tsx --test src/features/profile/services/profileDomain.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project devrem-rules-test \"tsx --test firestore.rules.test.ts\"",
    "test:storage-rules": "firebase emulators:exec --only storage --project devrem-storage-rules-test \"tsx --test storage.rules.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "^26.1.0",
    "@react-native-firebase/auth": "^26.1.0",
    "@react-native-firebase/firestore": "^26.1.0",
    "@react-native-firebase/storage": "^26.1.0",
    "expo": "~57.0.11",
    "expo-build-properties": "~57.0.6",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "26.1.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.1",
    "firebase": "12.17.0",
    "firebase-tools": "^15.26.0",
    "tsx": "4.20.6",
    "typescript": "~6.0.3"
  }
}
