rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isDevreGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/devreGroups/$(groupId)/members/$(request.auth.uid))
        && (
          !('status' in get(/databases/$(database)/documents/devreGroups/$(groupId)/members/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/devreGroups/$(groupId)/members/$(request.auth.uid)).data.status == 'active'
        );
    }

    function isValidGroupMessageReply(groupId, messageId) {
      return (
          request.resource.data.schemaVersion == 3
          && !request.resource.data.keys().hasAny(['replyToMessageId'])
        ) || (
          request.resource.data.schemaVersion == 4
          && request.resource.data.keys().hasAll(['replyToMessageId'])
          && (
            request.resource.data.replyToMessageId == null
            || (
              request.resource.data.replyToMessageId is string
              && request.resource.data.replyToMessageId != messageId
              && exists(/databases/$(database)/documents/devreGroups/$(groupId)/messages/$(request.resource.data.replyToMessageId))
            )
          )
        );
    }

    function isOwnProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidProfileShape(uid) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid',
          'firstName',
          'lastName',
          'birthYear',
          'residenceCity',
          'departureCity',
          'militaryCity',
          'militaryType',
          'militaryPeriodYear',
          'militaryPeriodMonth',
          'militaryUnit',
          'reportingDate',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'firstName',
          'lastName',
          'birthYear',
          'residenceCity',
          'departureCity',
          'militaryCity',
          'militaryType',
          'militaryPeriodYear',
          'militaryPeriodMonth',
          'militaryUnit',
          'militaryUnitId',
          'militaryUnitNameSnapshot',
          'forceCode',
          'reportingDate',
          'onboardingCompleted',
          'createdAt',
          'updatedAt',
          'photoPath'
        ])
        && data.uid == uid
        && data.firstName is string
        && data.firstName.size() >= 2
        && data.firstName.size() <= 50
        && data.lastName is string
        && data.lastName.size() >= 2
        && data.lastName.size() <= 50
        && data.birthYear is int
        && data.birthYear >= request.time.year() - 100
        && data.birthYear <= request.time.year() - 18
        && data.residenceCity is int
        && data.residenceCity >= 1
        && data.residenceCity <= 81
        && data.departureCity is int
        && data.departureCity >= 1
        && data.departureCity <= 81
        && data.militaryCity is int
        && data.militaryCity >= 1
        && data.militaryCity <= 81
        && data.militaryType in ['standard', 'paid', 'reserveOfficer', 'reserveNco']
        && data.militaryPeriodYear is int
        && data.militaryPeriodYear >= 2000
        && data.militaryPeriodYear <= request.time.year() + 5
        && data.militaryPeriodMonth is int
        && data.militaryPeriodMonth >= 1
        && data.militaryPeriodMonth <= 12
        && (
          data.militaryUnit == null
          || (
            data.militaryUnit is string
            && data.militaryUnit.size() >= 2
            && data.militaryUnit.size() <= 120
          )
        )
        && (
          !('militaryUnitId' in data)
          || data.militaryUnitId == null
          || (data.militaryUnitId is string && data.militaryUnitId.size() >= 3 && data.militaryUnitId.size() <= 160)
        )
        && (
          !('militaryUnitNameSnapshot' in data)
          || data.militaryUnitNameSnapshot == null
          || (data.militaryUnitNameSnapshot is string && data.militaryUnitNameSnapshot.size() >= 2 && data.militaryUnitNameSnapshot.size() <= 120)
        )
        && (
          !('forceCode' in data)
          || data.forceCode == null
          || data.forceCode in ['land', 'air', 'navy', 'gendarmerie', 'coast_guard']
        )
        && data.reportingDate is string
        && data.reportingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          !('photoPath' in data)
          || data.photoPath == null
          || data.photoPath == 'users/' + uid + '/profile/avatar.jpg'
        )
        && data.onboardingCompleted == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasCurrentOrFutureProfilePeriod() {
      let data = request.resource.data;
      return data.militaryPeriodYear > request.time.year()
        || (
          data.militaryPeriodYear == request.time.year()
          && data.militaryPeriodMonth >= request.time.month()
        );
    }

    function keepsExistingHistoricalProfilePeriod() {
      return request.resource.data.militaryPeriodYear == resource.data.militaryPeriodYear
        && request.resource.data.militaryPeriodMonth == resource.data.militaryPeriodMonth;
    }

    function hasValidPreparationItemShape(itemId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id',
          'title',
          'category',
          'completed',
          'source',
          'sortOrder',
          'priority',
          'helper',
          'templateKey',
          'templateVersion',
          'createdAt',
          'updatedAt',
          'completedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'title',
          'category',
          'completed',
          'source',
          'sortOrder',
          'priority',
          'helper',
          'templateKey',
          'templateVersion',
          'createdAt',
          'updatedAt',
          'completedAt'
        ])
        && data.id == itemId
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 100
        && data.category in [
          'official',
          'documents',
          'travel',
          'moneyCommunication',
          'personal',
          'bagEquipment'
        ]
        && data.completed is bool
        && data.source in ['default', 'custom']
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 1000000
        && data.priority in ['normal', 'important']
        && (
          data.helper == null
          || (data.helper is string && data.helper.size() <= 240)
        )
        && (
          data.templateKey == null
          || (data.templateKey is string && data.templateKey.size() >= 1 && data.templateKey.size() <= 100)
        )
        && (
          data.templateVersion == null
          || (data.templateVersion is int && data.templateVersion >= 1 && data.templateVersion <= 100)
        )
        && (
          (data.source == 'default' && data.templateKey is string && data.templateVersion is int)
          || (data.source == 'custom' && data.templateKey == null && data.templateVersion == null)
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          (data.completed == true && data.completedAt is timestamp)
          || (data.completed == false && data.completedAt == null)
        );
    }

    function hasValidPreparationStateShape() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'templateVersion',
          'longPressHintDismissed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'templateVersion',
          'longPressHintDismissed',
          'createdAt',
          'updatedAt'
        ])
        && data.templateVersion is int
        && data.templateVersion >= 0
        && data.templateVersion <= 100
        && data.longPressHintDismissed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidNotificationPreferencesShape() {
      let data = request.resource.data;
      return data.keys().hasAll(['enabled', 'groupMessagesEnabled', 'discovery', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['enabled', 'groupMessagesEnabled', 'discovery', 'createdAt', 'updatedAt'])
        && data.enabled is bool
        && data.groupMessagesEnabled is bool
        && data.discovery is map
        && data.discovery.keys().hasAll([
          'newDevre',
          'sameResidenceCity',
          'sameDepartureCity'
        ])
        && data.discovery.keys().hasOnly([
          'newDevre',
          'sameResidenceCity',
          'sameDepartureCity'
        ])
        && data.discovery.newDevre is bool
        && data.discovery.sameResidenceCity is bool
        && data.discovery.sameDepartureCity is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidDeviceRegistrationShape(installationId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'installationId',
          'token',
          'platform',
          'enabled',
          'appVersion',
          'createdAt',
          'updatedAt',
          'lastSeenAt'
        ])
        && data.keys().hasOnly([
          'installationId',
          'token',
          'platform',
          'enabled',
          'appVersion',
          'createdAt',
          'updatedAt',
          'lastSeenAt'
        ])
        && data.installationId == installationId
        && data.token is string
        && data.token.size() >= 20
        && data.token.size() <= 4096
        && data.platform in ['android', 'ios']
        && data.enabled is bool
        && data.appVersion is string
        && data.appVersion.size() >= 1
        && data.appVersion.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastSeenAt is timestamp;
    }

    function hasValidCommunicationPreferencesShape() {
      let data = request.resource.data;
      return data.keys().hasAll(['allowDirectMessages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['allowDirectMessages', 'createdAt', 'updatedAt'])
        && data.allowDirectMessages is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidLegalAcceptanceShape() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'termsAcceptedVersion',
          'termsAcceptedAt',
          'privacyNoticeAcknowledgedVersion',
          'privacyNoticeAcknowledgedAt'
        ])
        && data.keys().hasOnly([
          'termsAcceptedVersion',
          'termsAcceptedAt',
          'privacyNoticeAcknowledgedVersion',
          'privacyNoticeAcknowledgedAt'
        ])
        && data.termsAcceptedVersion == '2026-08-20-v1'
        && data.termsAcceptedAt is timestamp
        && data.privacyNoticeAcknowledgedVersion == '2026-08-20-v1'
        && data.privacyNoticeAcknowledgedAt is timestamp;
    }

    function hasValidDevreGroupStateShape() {
      let data = request.resource.data;
      return data.keys().hasAll(['acknowledgedGroupId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['acknowledgedGroupId', 'createdAt', 'updatedAt'])
        && data.acknowledgedGroupId is string
        && data.acknowledgedGroupId.size() >= 16
        && data.acknowledgedGroupId.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwnProfile(uid);

      allow create: if isOwnProfile(uid)
        && hasValidProfileShape(uid)
        && hasCurrentOrFutureProfilePeriod()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwnProfile(uid)
        && hasValidProfileShape(uid)
        && (
          hasCurrentOrFutureProfilePeriod()
          || keepsExistingHistoricalProfilePeriod()
        )
        && resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /users/{uid}/preparationItems/{itemId} {
      allow read: if isOwnProfile(uid);

      allow create: if isOwnProfile(uid)
        && hasValidPreparationItemShape(itemId)
        && request.resource.data.completed == false
        && request.resource.data.completedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwnProfile(uid)
        && hasValidPreparationItemShape(itemId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.source == resource.data.source
        && request.resource.data.priority == resource.data.priority
        && request.resource.data.helper == resource.data.helper
        && request.resource.data.templateKey == resource.data.templateKey
        && request.resource.data.templateVersion == resource.data.templateVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwnProfile(uid);
    }

    match /users/{uid}/preparationState/{stateId} {
      allow read: if isOwnProfile(uid) && stateId == 'main';

      allow create: if isOwnProfile(uid)
        && stateId == 'main'
        && hasValidPreparationStateShape()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwnProfile(uid)
        && stateId == 'main'
        && hasValidPreparationStateShape()
        && request.resource.data.templateVersion >= resource.data.templateVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /users/{uid}/notificationPreferences/{preferenceId} {
      allow read: if isOwnProfile(uid) && preferenceId == 'main';

      allow create: if isOwnProfile(uid)
        && preferenceId == 'main'
        && hasValidNotificationPreferencesShape()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwnProfile(uid)
        && preferenceId == 'main'
        && hasValidNotificationPreferencesShape()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwnProfile(uid) && preferenceId == 'main';
    }

    match /users/{uid}/devices/{installationId} {
      allow read: if isOwnProfile(uid);

      allow create: if isOwnProfile(uid)
        && hasValidDeviceRegistrationShape(installationId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time;

      allow update: if isOwnProfile(uid)
        && hasValidDeviceRegistrationShape(installationId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time;

      allow delete: if isOwnProfile(uid);
    }

    match /users/{uid}/communicationPreferences/{preferenceId} {
      allow read: if isOwnProfile(uid) && preferenceId == 'main';
      allow create: if isOwnProfile(uid)
        && preferenceId == 'main'
        && hasValidCommunicationPreferencesShape()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnProfile(uid)
        && preferenceId == 'main'
        && hasValidCommunicationPreferencesShape()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwnProfile(uid) && preferenceId == 'main';
    }

    match /users/{uid}/legal/{documentId} {
      allow read: if isOwnProfile(uid) && documentId == 'acceptance';
      allow create, update: if isOwnProfile(uid)
        && documentId == 'acceptance'
        && hasValidLegalAcceptanceShape()
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.privacyNoticeAcknowledgedAt == request.time;
      allow delete: if false;
    }

    match /users/{uid}/devreGroupState/{stateId} {
      allow read: if isOwnProfile(uid) && stateId == 'main';
      allow create: if isOwnProfile(uid)
        && stateId == 'main'
        && hasValidDevreGroupStateShape()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnProfile(uid)
        && stateId == 'main'
        && hasValidDevreGroupStateShape()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwnProfile(uid) && stateId == 'main';
    }

    function isDirectParticipant(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/directConversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participantUids;
    }

    function directOtherUid(conversationId) {
      let participants = get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participantUids;
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function directMessagingAllowed(conversationId) {
      let otherUid = directOtherUid(conversationId);
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(otherUid))
        && !exists(/databases/$(database)/documents/users/$(otherUid)/blockedUsers/$(request.auth.uid));
    }

    match /users/{uid}/hiddenGroupMessages/{groupId}/messages/{messageId} {
      allow read: if isOwnProfile(uid);
      allow create: if isOwnProfile(uid)
        && request.resource.data.keys().hasOnly(['groupId', 'messageId', 'hiddenAt'])
        && request.resource.data.groupId == groupId
        && request.resource.data.messageId == messageId
        && request.resource.data.hiddenAt == request.time;
      allow update: if false;
      allow delete: if isOwnProfile(uid);
    }

    match /users/{uid}/hiddenDirectMessages/{conversationId}/messages/{messageId} {
      allow read: if isOwnProfile(uid);
      allow create: if isOwnProfile(uid)
        && isDirectParticipant(conversationId)
        && request.resource.data.keys().hasOnly(['conversationId', 'messageId', 'hiddenAt'])
        && request.resource.data.conversationId == conversationId
        && request.resource.data.messageId == messageId
        && request.resource.data.hiddenAt == request.time;
      allow update: if false;
      allow delete: if isOwnProfile(uid);
    }

    match /_devreGroupMemberships/{uid} {
      allow read: if isOwnProfile(uid);
      allow create, update, delete: if false;
    }

    match /_travelGroupMemberships/{uid} {
      allow read: if isOwnProfile(uid);
      allow create, update, delete: if false;
    }

    match /users/{uid}/blockedUsers/{blockedUid} {
      allow read: if isOwnProfile(uid);
      allow create: if isOwnProfile(uid)
        && blockedUid != uid
        && request.resource.data.keys().hasOnly(['blockedUid', 'createdAt'])
        && request.resource.data.blockedUid == blockedUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwnProfile(uid);
    }

    match /moderationReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'reportedUid', 'conversationType', 'conversationId', 'messageId', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.conversationType == 'direct'
        && request.resource.data.conversationId is string
        && isDirectParticipant(request.resource.data.conversationId)
        && (request.resource.data.messageId == null || (
          request.resource.data.messageId is string
          && exists(/databases/$(database)/documents/directConversations/$(request.resource.data.conversationId)/messages/$(request.resource.data.messageId))
        ))
        && request.resource.data.reason in ['Spam', 'Taciz / rahatsız etme', 'Uygunsuz içerik', 'Sahte / yanıltıcı profil', 'Diğer']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /directConversations/{conversationId} {
      allow read: if isDirectParticipant(conversationId);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isDirectParticipant(conversationId);
        allow create: if isDirectParticipant(conversationId)
          && directMessagingAllowed(conversationId)
          && request.resource.data.id == messageId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.clientCreatedAt is timestamp
          && (
            request.resource.data.replyToMessageId == null
            || (
              request.resource.data.replyToMessageId is string
              && request.resource.data.replyToMessageId != messageId
              && exists(/databases/$(database)/documents/directConversations/$(conversationId)/messages/$(request.resource.data.replyToMessageId))
            )
          )
          && request.resource.data.schemaVersion == 1
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly([
                'id', 'senderUid', 'type', 'text', 'createdAt', 'clientCreatedAt', 'replyToMessageId', 'schemaVersion'
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1500
              && request.resource.data.text.matches('^\\S([\\s\\S]*\\S)?$')
            )
            || (
              request.resource.data.type == 'image'
              && request.resource.data.keys().hasOnly([
                'id', 'senderUid', 'type', 'mediaPath', 'caption', 'width', 'height',
                'createdAt', 'clientCreatedAt', 'replyToMessageId', 'schemaVersion'
              ])
              && request.resource.data.mediaPath == 'directConversations/' + conversationId + '/media/' + messageId + '/image.jpg'
              && request.resource.data.caption is string
              && request.resource.data.caption.size() <= 1500
              && request.resource.data.width is int
              && request.resource.data.height is int
              && request.resource.data.width > 0
              && request.resource.data.height > 0
              && request.resource.data.width <= 1600
              && request.resource.data.height <= 1600
            )
            || (
              request.resource.data.type == 'document'
              && request.resource.data.keys().hasOnly([
                'id', 'senderUid', 'type', 'mediaPath', 'fileName', 'mimeType', 'sizeBytes', 'extension',
                'createdAt', 'clientCreatedAt', 'replyToMessageId', 'schemaVersion'
              ])
              && request.resource.data.mediaPath == 'directConversations/' + conversationId + '/media/' + messageId + '/document'
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && request.resource.data.fileName.size() <= 120
              && request.resource.data.sizeBytes is int
              && request.resource.data.sizeBytes > 0
              && request.resource.data.sizeBytes <= 20 * 1024 * 1024
              && (
                (request.resource.data.extension == 'pdf' && request.resource.data.mimeType == 'application/pdf')
                || (request.resource.data.extension == 'doc' && request.resource.data.mimeType == 'application/msword')
                || (request.resource.data.extension == 'docx' && request.resource.data.mimeType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document')
                || (request.resource.data.extension == 'xls' && request.resource.data.mimeType == 'application/vnd.ms-excel')
                || (request.resource.data.extension == 'xlsx' && request.resource.data.mimeType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
                || (request.resource.data.extension == 'ppt' && request.resource.data.mimeType == 'application/vnd.ms-powerpoint')
                || (request.resource.data.extension == 'pptx' && request.resource.data.mimeType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation')
              )
            )
          );
        allow update: if isDirectParticipant(conversationId)
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForEveryone', 'deletedAt', 'deletedBy'])
          && resource.data.deletedForEveryone != true
          && request.resource.data.deletedForEveryone == true
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == request.auth.uid;
        allow delete: if false;
      }

      match /readCursors/{uid} {
        allow read: if isDirectParticipant(conversationId);
        allow create, update: if isDirectParticipant(conversationId)
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.lastReadMessageId is string
          && request.resource.data.lastReadMessageCreatedAt is timestamp
          && request.resource.data.lastReadAt == request.time;
        allow delete: if request.auth.uid == uid;
      }

      match /participantStates/{uid} {
        allow read: if isDirectParticipant(conversationId) && request.auth.uid == uid;
        allow create: if isDirectParticipant(conversationId)
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.unreadCount == 0
          && (
            (
              request.resource.data.keys().hasOnly(['uid', 'unreadCount', 'lastReadAt'])
              && request.resource.data.lastReadAt == request.time
            )
            || (
              request.resource.data.keys().hasOnly(['uid', 'unreadCount', 'hidden', 'hiddenAt'])
              && request.resource.data.hidden == true
              && request.resource.data.hiddenAt == request.time
            )
          );
        allow update: if isDirectParticipant(conversationId)
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount', 'lastReadAt'])
              && request.resource.data.unreadCount == 0
              && request.resource.data.lastReadAt == request.time
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount', 'hidden', 'hiddenAt'])
              && request.resource.data.unreadCount == 0
              && request.resource.data.hidden == true
              && request.resource.data.hiddenAt == request.time
            )
          );
        allow delete: if false;
      }
    }

    // Owner-private collection-group read used by the bounded Conversations inbox.
    // Message authorization continues to use the authoritative conversation and
    // two-way block documents above; this state is presentation data only.
    match /{conversationPath=**}/participantStates/{stateUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /devreGroups/{groupId} {
      allow read: if isDevreGroupMember(groupId);
      allow create, update, delete: if false;

      match /members/{memberUid} {
        allow read: if isDevreGroupMember(groupId);
        allow create, update, delete: if false;
      }

      match /groupEvents/{eventId} {
        allow read: if isDevreGroupMember(groupId);
        allow create, update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isDevreGroupMember(groupId);
        allow create: if isDevreGroupMember(groupId)
          && request.resource.data.id == messageId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.clientCreatedAt is timestamp
          && isValidGroupMessageReply(groupId, messageId)
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly([
                'id', 'senderUid', 'type', 'text', 'createdAt', 'clientCreatedAt', 'replyToMessageId', 'schemaVersion'
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1500
              && request.resource.data.text.matches('^\\S([\\s\\S]*\\S)?$')
            )
            || (
              request.resource.data.type == 'image'
              && request.resource.data.keys().hasOnly([
                'id', 'senderUid', 'type', 'mediaPath', 'caption', 'width', 'height',
                'createdAt', 'clientCreatedAt', 'replyToMessageId', 'schemaVersion'
              ])
              && request.resource.data.mediaPath == 'devreGroups/' + groupId + '/media/' + messageId + '/image.jpg'
              && request.resource.data.caption is string
              && request.resource.data.caption.size() <= 1500
              && (request.resource.data.caption.size() == 0 || request.resource.data.caption.matches('^\\S([\\s\\S]*\\S)?$'))
              && request.resource.data.width is int
              && request.resource.data.height is int
              && request.resource.data.width > 0
              && request.resource.data.height > 0
              && request.resource.data.width <= 1600
              && request.resource.data.height <= 1600
            )
            || (
              request.resource.data.type == 'audio'
              && request.resource.data.keys().hasOnly([
                'id', 'senderUid', 'type', 'mediaPath', 'durationMillis',
                'createdAt', 'clientCreatedAt', 'replyToMessageId', 'schemaVersion'
              ])
              && request.resource.data.mediaPath == 'devreGroups/' + groupId + '/media/' + messageId + '/audio.m4a'
              && request.resource.data.durationMillis is int
              && request.resource.data.durationMillis > 0
              && request.resource.data.durationMillis <= 180000
            )
            || (
              request.resource.data.type == 'document'
              && request.resource.data.keys().hasOnly([
                'id', 'senderUid', 'type', 'mediaPath', 'fileName', 'mimeType', 'sizeBytes',
                'extension', 'createdAt', 'clientCreatedAt', 'replyToMessageId', 'schemaVersion'
              ])
              && request.resource.data.mediaPath == 'devreGroups/' + groupId + '/media/' + messageId + '/document'
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && request.resource.data.fileName.size() <= 120
              && request.resource.data.sizeBytes is int
              && request.resource.data.sizeBytes > 0
              && request.resource.data.sizeBytes <= 20 * 1024 * 1024
              && (
                (request.resource.data.extension == 'pdf' && request.resource.data.mimeType == 'application/pdf')
                || (request.resource.data.extension == 'doc' && request.resource.data.mimeType == 'application/msword')
                || (request.resource.data.extension == 'docx' && request.resource.data.mimeType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document')
                || (request.resource.data.extension == 'xls' && request.resource.data.mimeType == 'application/vnd.ms-excel')
                || (request.resource.data.extension == 'xlsx' && request.resource.data.mimeType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
                || (request.resource.data.extension == 'ppt' && request.resource.data.mimeType == 'application/vnd.ms-powerpoint')
                || (request.resource.data.extension == 'pptx' && request.resource.data.mimeType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation')
              )
            )
          );
        allow update: if isDevreGroupMember(groupId)
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deletedForEveryone', 'deletedAt', 'deletedBy'
          ])
          && !resource.data.keys().hasAny(['deletedForEveryone'])
          && request.resource.data.deletedForEveryone == true
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == request.auth.uid;
        allow delete: if false;
      }

      match /readCursors/{uid} {
        allow read: if isDevreGroupMember(groupId);
        allow create: if isDevreGroupMember(groupId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'uid', 'lastReadMessageId', 'lastReadMessageCreatedAt', 'lastReadAt', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.lastReadMessageId is string
          && request.resource.data.lastReadMessageCreatedAt == get(/databases/$(database)/documents/devreGroups/$(groupId)/messages/$(request.resource.data.lastReadMessageId)).data.createdAt
          && request.resource.data.lastReadAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isDevreGroupMember(groupId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'uid', 'lastReadMessageId', 'lastReadMessageCreatedAt', 'lastReadAt', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.lastReadMessageCreatedAt >= resource.data.lastReadMessageCreatedAt
          && request.resource.data.lastReadMessageCreatedAt == get(/databases/$(database)/documents/devreGroups/$(groupId)/messages/$(request.resource.data.lastReadMessageId)).data.createdAt
          && request.resource.data.lastReadAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow delete: if request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
